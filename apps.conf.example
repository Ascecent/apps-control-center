# Apps Control Center config
#
# [profile]              selectable profile
# [utilities]            always available across profile switches
# @name: folder          named project — following commands share cwd
# @folder                same, project label = folder basename
# name: folder | cmd     classic one-liner (exits current @ project)
# name: cmd              command only
#
# Omit headers for a single "default" profile.

[utilities]
mailpit: ~/tools/mailpit | ./mailpit

[work]
@api: ~/work/api
serve: php artisan serve
queue: php artisan queue:work
pail: php artisan pail

@web: ~/work/web
vite: npm run dev

[personal]
@blog: ~/personal/blog
dev: npm run dev
build: npm run build
